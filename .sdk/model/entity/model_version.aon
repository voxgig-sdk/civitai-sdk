# Entity: model_version

main: kit: entity: model_version: {

  alias: field: {}

  fields: [
    {
      format: "date-time"
      name: "createdAt"
      req: false
      short: "The date in which the version was created"
      type: "`$STRING`"
    }
    {
      name: "description"
      req: false
      short: "The description of the model version (usually a changelog)"
      type: "`$STRING`"
    }
    {
      name: "downloadUrl"
      req: false
      short: "The download url to get the model file for this specific version"
      type: "`$STRING`"
    }
    {
      name: "files"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "id"
      req: false
      short: "The identifier for the model version"
      type: "`$INTEGER`"
    }
    {
      name: "images"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "name"
      req: false
      short: "The name of the model version"
      type: "`$STRING`"
    }
    {
      name: "stats"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "trainedWords"
      req: false
      short: "The words used to trigger the model"
      type: "`$ARRAY`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "model_version"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "hash"
                orig: "hash"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/model-versions/by-hash/{hash}"
          segments: [
            {
              lit: "model-versions"
            }
            {
              lit: "by-hash"
            }
            {
              var: "hash"
            }
          ]
          select: {
            exist: [
              "hash"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "model_version_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/model-versions/{modelVersionId}"
          rename: {
            param: {
              modelVersionId: "id"
            }
          }
          segments: [
            {
              lit: "model-versions"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "by_hash"
      ]
    ]
  }



}
